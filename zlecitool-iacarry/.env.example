# Cópialo a .env (git lo ignora). Sólo lo lee `python app.py`, en desarrollo;
# en un servidor las variables las pone el alojamiento.

# ── Comunes a todas las herramientas zlecitool (CONTRATO.md del núcleo) ──

# OBLIGATORIO. Firma la sesión. El MISMO en todas las herramientas: es lo que
# hace que entrar en una sea haber entrado en todas. Genera uno con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Raíz de datos común. Vacío = data/ junto a la app.
ZLECITOOL_DATA_DIR=

# Base de datos común. Vacío = SQLite en <ZLECITOOL_DATA_DIR>/zlecitool.db.
# Para compartir cuentas entre herramientas en local, la MISMA en todas,
# p. ej. sqlite:////home/yo/tools/zlecitool.db. En producción, Postgres.
DATABASE_URL=

# Producción con Postgres detrás de PgBouncer (modo transaction): DATABASE_URL
# apunta a PgBouncer (puerto 6432) y esto lo dice. Las cuentas de conexiones y
# un pgbouncer.ini de ejemplo: CONTRATO.md del núcleo, §4, y su docs/pgbouncer.ini.
# ZLECITOOL_DB_POOL=pgbouncer
# Conexiones que guarda cada proceso (con PgBouncer, 4; 0 = ninguna).
# ZLECITOOL_DB_POOL_SIZE=4
# Postgres SIN PgBouncer (puerto 5432), para pg_dump: sin ella, detrás de
# PgBouncer no hay copias de seguridad.
# ZLECITOOL_DB_DIRECT_URL=postgresql://zlecitool:…@127.0.0.1:5432/zlecitool

# Sólo con las herramientas en subdominios (exam-c1.tudominio.com…):
# .tudominio.com. En local y con rutas, vacío.
ZLECITOOL_COOKIE_DOMAIN=

# Cuántos proxies hay delante en producción (nginx, balanceador…): normalmente 1.
ZLECITOOL_TRUSTED_PROXIES=

# Los datos del titular para las páginas legales (/legal/…), comunes a todas
# las herramientas. Sin ellos, las páginas enseñan «[pendiente: …]».
ZLECITOOL_LEGAL_OWNER=
ZLECITOOL_LEGAL_TAXID=
ZLECITOOL_LEGAL_ADDRESS=
ZLECITOOL_LEGAL_EMAIL=

# Producción: además de la salida estándar, logs en <dir>/<slug>.log.
ZLECITOOL_LOG_DIR=

# Créditos, comunes a todas las herramientas (el saldo es uno). Vacíos = los de
# por defecto: 15 de regalo a cada cuenta nueva; paquetes de 50/150/500 por
# 4,99/9,99/24,99 € (créditos:céntimos).
ZLECITOOL_WELCOME_CREDITS=
ZLECITOOL_CREDIT_PACKS=
# La pasarela de pago (aún ninguna conectada: sin ella no se vende) y el
# secreto con que firma sus avisos de pago (POST /zt/credits/webhook).
ZLECITOOL_PAYMENT_PROVIDER=
ZLECITOOL_PAYMENT_WEBHOOK_SECRET=

# IA (zlecitool_core.ai). En desarrollo, la falsa: contesta sin red, sin clave
# y sin gastar. Para la de verdad, quita esta línea y pon una clave.
ZLECITOOL_AI_FAKE=1
# Lo que tarda la falsa en contestar (segundos, o un intervalo: 5-20). Sólo
# para la prueba de carga (loadtest/): una IA de verdad tarda de 5 a 30 s.
# ZLECITOOL_AI_FAKE_DELAY=5-20
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# El modelo, si tool.json no dice "ai_model". Por defecto, claude-opus-5-5.
# ZLECITOOL_AI_MODEL=

# La dirección pública, sin ruta (https://tuisku.eu, o https://exam-c1.tuisku.eu
# con subdominios): los enlaces de los correos, la URL canónica, el sitemap.
# Obligatoria en producción. En desarrollo, vacía: se usa la de la petición.
ZLECITOOL_PUBLIC_URL=
# Un entorno de pruebas publicado: 1 y ningún buscador lo indexa.
# ZLECITOOL_NOINDEX=1

# Correo: «olvidé mi contraseña» y el aviso de cada mensaje de contacto. Sin
# SMTP (desarrollo), cada correo se escribe en <datos>/mail/*.eml.
ZLECITOOL_SMTP_HOST=
# ZLECITOOL_SMTP_PORT=587
# ZLECITOOL_SMTP_SECURITY=starttls
# ZLECITOOL_SMTP_USER=
# ZLECITOOL_SMTP_PASSWORD=
# ZLECITOOL_MAIL_FROM="tuisku <hola@tuisku.eu>"
# A quién avisar de cada mensaje de contacto (por defecto, ZLECITOOL_ADMINS).
# ZLECITOOL_CONTACT_TO=

# La caché de PDF del almacén (_cache/): cada día se borra lo que lleva más de
# estos días (a la hora de las copias, o a las 04:00 UTC). 0 = nunca sola
# (a mano: flask --app app zt cache sweep).
# ZLECITOOL_PDF_CACHE_DAYS=30

# Copias de seguridad: una cada día a esta hora (UTC), y cuántas se guardan.
# Sin ella, sólo a mano: flask --app app zt backup (o un cron).
# ZLECITOOL_BACKUP_DAILY_AT=03:30
# ZLECITOOL_BACKUP_KEEP=14

# Avisos de errores (un 500, un trabajo que muere): por correo a estos (por
# defecto, ZLECITOOL_ADMINS) y, si se quiere, también a Sentry
# (pip install zlecitool-core[sentry]).
# ZLECITOOL_ALERTS_TO=
# ZLECITOOL_SENTRY_DSN=
# ZLECITOOL_ENVIRONMENT=production

# Métricas (/zt/admin): los correos que ven el panel, separados por comas (los
# mismos en todas las herramientas; para el resto, 404), y cuántos euros vale
# un dólar para calcular el margen (ingresos − coste de la IA).
ZLECITOOL_ADMINS=
# ZLECITOOL_USD_EUR=0.92

# ── Propias de esta herramienta ──

# El detector (tuisku_iaCarry/serving/detector_service.py), en la red interna.
# Vacío (o «fake»): el detector falso, que contesta las fotos de ejemplo sin
# TensorFlow ni red. Con él, la ficha compartida y cuánto se le espera.
IACARRY_DETECTOR_URL=
# IACARRY_DETECTOR_TOKEN=
# IACARRY_DETECTOR_TIMEOUT=20

# Puerto. Una herramienta distinta en cada puerto para tener varias abiertas a
# la vez; en localhost la cookie vale para todos los puertos, así que la
# sesión se comparte también en local.
PORT=5000

# Producción (gunicorn.conf.py): procesos, hilos y espera máxima.
# WEB_CONCURRENCY=9
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=360
# GUNICORN_MAX_REQUESTS=10000
# Detrás de un balanceador que reutiliza conexiones: más que su espera (75 con un ALB de 60).
# GUNICORN_KEEPALIVE=2
